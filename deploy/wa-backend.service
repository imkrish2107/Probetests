# /etc/systemd/system/wa-backend.service
# One worker only: MMS voices stay loaded once in memory.
# Install: sudo cp deploy/wa-backend.service /etc/systemd/system/ &&
#          sudo systemctl daemon-reload && sudo systemctl enable --now wa-backend
[Unit]
Description=WhatsApp AI backend
After=network.target

[Service]
User=wa
WorkingDirectory=/home/wa/Probetests/backend
EnvironmentFile=/home/wa/Probetests/backend/.env
ExecStart=/home/wa/Probetests/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

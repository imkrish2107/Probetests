# /etc/nginx/sites-available/api.probetests.space
# HTTPS terminates here; FastAPI runs on 127.0.0.1:8000 (see deploy/wa-backend.service).
# Call audio (UDP) goes straight to the VPS, not through nginx — open it in the firewall at step 3.
upstream wa_backend {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name api.probetests.space;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name api.probetests.space;

    # Issued by: certbot --nginx -d api.probetests.space (auto-renews)
    ssl_certificate /etc/letsencrypt/live/api.probetests.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.probetests.space/privkey.pem;

    client_max_body_size 5m;

    location / {
        proxy_pass http://wa_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
